<!doctype html>
<html>
<head><meta charset="utf-8"><title>Launchpad</title>
<style>
  body { margin: 0; font: 12px Arial, sans-serif; }
  .sc-globalHeader { position: fixed; top: 0; left: 0; right: 0; height: 50px; background: #fff; }
  .sc-global-logo { position: absolute; left: 12px; top: 9px; width: 33px; height: 33px; }
  .sc-accountInformation { float: right; margin: 0 15px 0 0; padding: 0; line-height: 50px; list-style: none; }
  .sc-accountInformation li { display: inline-block; margin-left: 12px; }
  /* the Sitecore Extensions add-on's own rule */
  .sc-ext-dbName { position: fixed; width: 100%; text-align: center; line-height: 50px; }
</style></head>
<body>
<header class="sc-globalHeader"><div class="sc-ext-dbName">MASTER</div>
  <div class="sc-globalHeader-content"><a class="sc-global-logo" href="#"></a>
    <div class="sc-globalHeader-loginInfo"><ul class="sc-accountInformation"><li><a class="logout" href="#">Log out</a></li><li>admin</li></ul></div>
  </div>
</header>
</body>
</html>
