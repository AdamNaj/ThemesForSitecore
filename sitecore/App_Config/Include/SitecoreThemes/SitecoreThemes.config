<?xml version="1.0" encoding="utf-8"?>
<!-- Themes for Sitecore, deployed into Sitecore: the theme loader on the Content Management UIs. -->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/">
  <sitecore role:require="Standalone or ContentManagement">
    <pipelines>
      <httpRequestBegin>
        <processor type="SitecoreThemes.ThemesProcessor, SitecoreThemes"
                   patch:after="processor[@type='Sitecore.Pipelines.HttpRequest.UserResolver, Sitecore.Kernel']" />
      </httpRequestBegin>
    </pipelines>
    <settings>
      <!-- The theme for users who have not picked one, and for the login page: a theme id from themes.js
           (native, debrightify, fjord, cupertino, ...). -->
      <setting name="SitecoreThemes.DefaultTheme" value="native" />
      <!-- Shown after the page title and in Sitecore's top bar, to tell instances apart. -->
      <setting name="SitecoreThemes.Title" value="" />
      <!-- The tab icon's tint: empty for none, "theme" for the theme's accent, or #rrggbb. -->
      <setting name="SitecoreThemes.Tint" value="" />
      <!-- prod, staging, qa, dev, sandbox, local or beta, for themes that show it (Guardrail), until a user picks their own. -->
      <setting name="SitecoreThemes.Environment" value="" />
      <!-- Degrees round the colour wheel (1 to 359) for every theme that offers a hue, until a user picks their own for any of them; 0 keeps the themes' own colours. -->
      <setting name="SitecoreThemes.Hue" value="0" />
    </settings>
  </sitecore>
</configuration>
