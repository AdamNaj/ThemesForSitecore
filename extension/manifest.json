{
  "manifest_version": 3,
  "name": "Themes for Sitecore",
  "short_name": "Themes for Sitecore",
  "version": "0.5.0",
  "description": "Themes for the Sitecore 10.0-10.5 Desktop and CM UIs: dark, high contrast, classic Sitecore, retro and modern desktops, and more.",
  "homepage_url": "https://github.com/AdamNaj/ThemesForSitecore",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["themes/*/glyphs/*", "fonts/*"],
      "matches": ["*://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Themes for Sitecore",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "themes-for-sitecore@najmanowicz.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
